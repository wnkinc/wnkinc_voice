{
  "name": "wnkinc-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Agent platform for a small business: OpenAI Realtime phone receptionist + Bedrock AgentCore (Twilio SIP -> OpenAI -> AWS)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-tenant.ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-eventbridge": "^3.1116.0",
    "@aws-sdk/client-lambda": "^3.1116.0",
    "@aws-sdk/client-secrets-manager": "^3.1116.0",
    "@aws-sdk/client-ses": "^3.1116.0",
    "@aws-sdk/client-sns": "^3.1116.0",
    "@aws-sdk/client-sqs": "^3.1116.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@openai/agents": "^0.17.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0",
    "openai": "^7.5.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "aws-cdk": "^2.1100.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
