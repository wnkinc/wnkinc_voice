{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "packages/infrastructure/**/*.ts", "scripts/**/*.ts", "deployments/*/*.ts", "deployments/*/tenants/*.ts", "deployments/*/test/**/*.ts"],
  "exclude": ["node_modules", "vendor", "**/cdk.out"]
}
