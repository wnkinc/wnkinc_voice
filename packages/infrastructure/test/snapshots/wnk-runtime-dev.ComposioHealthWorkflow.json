{
  "QueryLanguage": "JSONata",
  "StartAt": "ListTenants",
  "States": {
    "ListTenants": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:scan",
      "Arguments": {
        "TableName": "placeholder"
      },
      "Assign": {
        "tenants": "{% [$states.result.Items] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "EachTenant"
    },
    "EachTenant": {
      "Type": "Map",
      "Items": "{% $tenants %}",
      "MaxConcurrency": 2,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Expect",
        "States": {
          "Expect": {
            "Type": "Pass",
            "Assign": {
              "tenantId": "{% $states.input.tenantId.S %}",
              "expected": "{% $append($append( ($states.input.crm.M.type.S = 'hubspot' and $states.input.crm.M.via.S = 'composio' ? ['hubspot'] : []), ($states.input.emailResponder.M.enabled.Bool = true ? ['gmail'] : [])), ($states.input.facebookPosts.M.enabled.Bool = true ? ['facebook'] : []) ) %}",
              "needsAny": "{% $states.input.assistant.M.enabled.Bool = true %}"
            },
            "Output": "{% $states.input %}",
            "Next": "UsesComposio"
          },
          "UsesComposio": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $count($expected) > 0 or $needsAny %}",
                "Next": "ActiveAccounts"
              }
            ],
            "Default": "NotUsed"
          },
          "NotUsed": {
            "Type": "Succeed"
          },
          "ActiveAccounts": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Arguments": {
              "ApiEndpoint": "https://backend.composio.dev/api/v3.1/connected_accounts",
              "Method": "GET",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
              },
              "QueryParameters": {
                "user_ids": "{% $tenantId %}",
                "statuses": "ACTIVE"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 1
              }
            ],
            "Assign": {
              "active": "{% [$states.result.ResponseBody.items.toolkit.slug] %}"
            },
            "Output": "{% $states.input %}",
            "Next": "AllPresent"
          },
          "AllPresent": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $count([$filter($expected, function($t) { $not($t in $active) })]) = 0 and ($needsAny ? $count($active) > 0 : true) %}",
                "Next": "Healthy"
              }
            ],
            "Default": "Unhealthy"
          },
          "Healthy": {
            "Type": "Succeed"
          },
          "Unhealthy": {
            "Type": "Fail",
            "Error": "ComposioConnectionMissing",
            "Cause": "{% 'tenant ' & $tenantId & ': ' & ($count([$filter($expected, function($t) { $not($t in $active) })]) > 0 ? 'no ACTIVE Composio account for ' & $join([$filter($expected, function($t) { $not($t in $active) })], ', ') : 'assistant is on but no ACTIVE Composio account at all') & '. Reconnect: npx tsx scripts/connect-composio.mts ' & $tenantId & ' <toolkit>' %}"
          }
        }
      },
      "End": true
    }
  }
}
