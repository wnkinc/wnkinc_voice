{
  "QueryLanguage": "JSONata",
  "StartAt": "LookupTenant",
  "States": {
    "LookupTenant": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $states.input.tenantPhoneNumber %}"
          }
        }
      },
      "Assign": {
        "tenant": "{% $states.result.Item %}",
        "chatId": "{% $states.input.chatId %}",
        "site": "{% $trim($substring($states.input.text, 6)) %}"
      },
      "Output": "{% $states.input %}",
      "Next": "BrowserEnabled"
    },
    "BrowserEnabled": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($tenant) and $tenant.browser.M.enabled.BOOL = true %}",
          "Next": "ClaimWindow"
        }
      ],
      "Default": "NotEnabled"
    },
    "NotEnabled": {
      "Type": "Fail",
      "Error": "BrowserNotEnabled",
      "Cause": "browser.enabled is not true on the tenant row"
    },
    "ClaimWindow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $tenant.phoneNumber.S %}"
          }
        },
        "UpdateExpression": "SET #b.loginUntil = :until",
        "ConditionExpression": "attribute_not_exists(#b.loginUntil) OR #b.loginUntil < :now",
        "ExpressionAttributeNames": {
          "#b": "browser"
        },
        "ExpressionAttributeValues": {
          ":until": {
            "S": "{% $fromMillis($millis() + 900000) %}"
          },
          ":now": {
            "S": "{% $now() %}"
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "Output": "{% $states.input %}",
          "Next": "TellBusy"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "HasContext"
    },
    "TellBusy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Arguments": {
        "Entries": [
          {
            "EventBusName": "placeholder",
            "Source": "wnkinc.assistant",
            "DetailType": "telegram.reply",
            "Detail": "{% $string({'tenantId': $tenant.tenantId.S, 'chatId': $chatId, 'text': 'A browser is already open for this business. Use the link you have, or try again once it closes.'}) %}"
          }
        ]
      },
      "Output": "{% $states.input %}",
      "End": true
    },
    "HasContext": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($tenant.browser.M.contextId.S) %}",
          "Next": "UseContext"
        }
      ],
      "Default": "CreateContext"
    },
    "UseContext": {
      "Type": "Pass",
      "Assign": {
        "contextId": "{% $tenant.browser.M.contextId.S %}",
        "created": false
      },
      "Output": "{% $states.input %}",
      "Next": "StartSession"
    },
    "CreateContext": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://api.browserbase.com/v1/contexts",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "projectId": "cb1054bf-305b-4a28-8955-f74859c780ce",
          "name": "{% $tenant.tenantId.S %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "contextId": "{% $states.result.ResponseBody.id %}",
        "created": true
      },
      "Output": "{% $states.input %}",
      "Next": "SaveContext"
    },
    "SaveContext": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $tenant.phoneNumber.S %}"
          }
        },
        "UpdateExpression": "SET #b.contextId = :c",
        "ExpressionAttributeNames": {
          "#b": "browser"
        },
        "ExpressionAttributeValues": {
          ":c": {
            "S": "{% $contextId %}"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "StartSession"
    },
    "StartSession": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://api.browserbase.com/v1/sessions",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "projectId": "cb1054bf-305b-4a28-8955-f74859c780ce",
          "browserSettings": {
            "context": {
              "id": "{% $contextId %}",
              "persist": true
            },
            "solveCaptchas": true
          },
          "keepAlive": true,
          "timeout": 900
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "sessionId": "{% $states.result.ResponseBody.id %}"
      },
      "Output": "{% $states.input %}",
      "Next": "LiveView"
    },
    "LiveView": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% 'https://api.browserbase.com/v1/sessions/' & $sessionId & '/debug' %}",
        "Method": "GET",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "url": "{% $states.result.ResponseBody.debuggerUrl %}"
      },
      "Output": "{% $states.input %}",
      "Next": "TellOwner"
    },
    "TellOwner": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Arguments": {
        "Entries": [
          {
            "EventBusName": "placeholder",
            "Source": "wnkinc.assistant",
            "DetailType": "telegram.reply",
            "Detail": "{% $string({'tenantId': $tenant.tenantId.S, 'chatId': $chatId, 'text': 'Browser ready' & ($site != '' ? ' for ' & $site : '') & '. Open the link, go to the site, and sign in. It closes in 10 minutes; the login is kept for next time. ' & $url & ($created ? '\\n\\nFirst browser for this business. Add browser.contextId = ' & $contextId & ' to the tenant file so a re-seed keeps it.' : '')}) %}"
          }
        ]
      },
      "Output": "{% $states.input %}",
      "Next": "Window"
    },
    "Window": {
      "Type": "Wait",
      "Seconds": 600,
      "Next": "Release"
    },
    "Release": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% 'https://api.browserbase.com/v1/sessions/' & $sessionId %}",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "projectId": "cb1054bf-305b-4a28-8955-f74859c780ce",
          "status": "REQUEST_RELEASE"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "ClearWindow"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "ClearWindow"
    },
    "ClearWindow": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $tenant.phoneNumber.S %}"
          }
        },
        "UpdateExpression": "REMOVE #b.loginUntil",
        "ExpressionAttributeNames": {
          "#b": "browser"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "TellClosed"
    },
    "TellClosed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Arguments": {
        "Entries": [
          {
            "EventBusName": "placeholder",
            "Source": "wnkinc.assistant",
            "DetailType": "telegram.reply",
            "Detail": "{% $string({'tenantId': $tenant.tenantId.S, 'chatId': $chatId, 'text': 'Browser closed. Whatever you signed into is saved for this business.'}) %}"
          }
        ]
      },
      "Output": "{% $states.input %}",
      "End": true
    }
  }
}
