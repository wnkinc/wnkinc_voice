{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "packages/infrastructure/bin/**/*.ts", "packages/infrastructure/stacks/**/*.ts", "packages/infrastructure/infra_utils/**/*.ts", "packages/infrastructure/workflows/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "vendor", "cdk.out"]
}
