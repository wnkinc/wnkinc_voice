{
  "name": "wnkinc-voice",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-tenant platform: the phone receptionist, the business assistant, the automations (Temporal, AgentCore, Twilio, OpenAI)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-tenant.ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "predeploy": "vitest run",
    "release": "tsx scripts/temporal-release.mts",
    "temporal": "tsx scripts/temporal.mts"
  },
  "devDependencies": {
    "@composio/core": "^0.18.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1100.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
