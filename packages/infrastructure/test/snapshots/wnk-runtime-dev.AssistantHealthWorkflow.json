{
  "QueryLanguage": "JSONata",
  "StartAt": "ListTenants",
  "States": {
    "ListTenants": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:scan",
      "Arguments": {
        "TableName": "placeholder"
      },
      "Assign": {
        "tenants": "{% [$states.result.Items] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "EachTenant"
    },
    "EachTenant": {
      "Type": "Map",
      "Items": "{% $tenants %}",
      "MaxConcurrency": 2,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "AssistantOn",
        "States": {
          "AssistantOn": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $states.input.assistant.M.enabled.Bool = true %}",
                "Next": "Prepare"
              }
            ],
            "Default": "NotUsed"
          },
          "NotUsed": {
            "Type": "Succeed"
          },
          "Prepare": {
            "Type": "Pass",
            "Assign": {
              "toolDefs": [
                {
                  "type": "function",
                  "name": "search_contacts",
                  "description": "Search the business CRM (HubSpot) for contacts by name, email address, or phone number. Phone numbers are stored in E.164 form such as +15095551234, so search with that exact format.",
                  "parameters": {
                    "type": "object",
                    "properties": {
                      "query": {
                        "type": "string",
                        "description": "A name, an email address, or an E.164 phone number"
                      }
                    },
                    "required": [
                      "query"
                    ],
                    "additionalProperties": false
                  },
                  "strict": true
                },
                {
                  "type": "function",
                  "name": "add_note",
                  "description": "Add a note to a CRM contact. Use search_contacts first to find the contact id.",
                  "parameters": {
                    "type": "object",
                    "properties": {
                      "contact_id": {
                        "type": "string",
                        "description": "The contact id from search_contacts"
                      },
                      "note": {
                        "type": "string",
                        "description": "The note text"
                      }
                    },
                    "required": [
                      "contact_id",
                      "note"
                    ],
                    "additionalProperties": false
                  },
                  "strict": true
                }
              ],
              "round": 0,
              "tokens": 0,
              "inputTokens": 0,
              "outputTokens": 0,
              "history": [],
              "memories": [],
              "tenant": "{% $states.input %}",
              "text": "Search the CRM for the phone number +15555550177 and reply in one short sentence with what you find.",
              "systemPrompt": "You are a scheduled health probe for a small business assistant. Use your tools to answer, and reply in one short sentence.",
              "actorId": "{% $states.input.tenantId.S & '_canary' %}",
              "sessionId": "{% 'canary-' & $states.input.tenantId.S & '-' & $fromMillis($millis(), '[Y0001][M01][D01]') %}",
              "allowedTools": [
                "search_contacts"
              ]
            },
            "Output": "{% $states.input %}",
            "Next": "LoadHistory"
          },
          "LoadHistory": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:bedrockagentcore:listEvents",
            "Arguments": {
              "MemoryId": "placeholder",
              "ActorId": "{% $actorId %}",
              "SessionId": "{% $sessionId %}",
              "IncludePayloads": true,
              "MaxResults": 20
            },
            "Assign": {
              "history": "{% [$sort([$states.result.Events], function($l, $r) { $l.EventTimestamp > $r.EventTimestamp }).Payload.Conversational.{ 'role': $lowercase(Role), 'content': Content.Text }] %}"
            },
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Output": "{% $states.input %}",
                "Next": "Recall"
              }
            ],
            "Output": "{% $states.input %}",
            "Next": "Recall"
          },
          "Recall": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:bedrockagentcore:retrieveMemoryRecords",
            "TimeoutSeconds": 5,
            "Arguments": {
              "MemoryId": "placeholder",
              "NamespacePath": "{% '/callers/' & $actorId %}",
              "SearchCriteria": {
                "SearchQuery": "{% $text %}",
                "TopK": 8
              }
            },
            "Assign": {
              "memories": "{% [$states.result.MemoryRecordSummaries.Content.Text] %}"
            },
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Output": "{% $states.input %}",
                "Next": "CallModel"
              }
            ],
            "Output": "{% $states.input %}",
            "Next": "CallModel"
          },
          "CallModel": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Arguments": {
              "ApiEndpoint": "https://api.openai.com/v1/responses",
              "Method": "POST",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
              },
              "Headers": {
                "content-type": "application/json"
              },
              "RequestBody": {
                "model": "gpt-5.5",
                "store": true,
                "max_output_tokens": 1200,
                "instructions": "{% $systemPrompt & ($count($memories) > 0 ? ' Things you remember about this person and this business: ' & $join($memories, ' | ') : '') %}",
                "tools": "{% [$toolDefs[name in $allowedTools]] %}",
                "input": "{% $append($history, [{ 'role': 'user', 'content': $text }]) %}"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.Http.StatusCode.429",
                  "States.Http.StatusCode.500",
                  "States.Http.StatusCode.502",
                  "States.Http.StatusCode.503",
                  "States.Http.StatusCode.504"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Assign": {
              "responseId": "{% $states.result.ResponseBody.id %}",
              "calls": "{% [$states.result.ResponseBody.output[type='function_call']] %}",
              "reply": "{% $count($states.result.ResponseBody.output[type='message']) > 0 ? $join($states.result.ResponseBody.output[type='message'].content[type='output_text'].text, ' ') : '' %}",
              "tokens": "{% $tokens + $states.result.ResponseBody.usage.total_tokens %}",
              "inputTokens": "{% $inputTokens + $states.result.ResponseBody.usage.input_tokens %}",
              "outputTokens": "{% $outputTokens + $states.result.ResponseBody.usage.output_tokens %}"
            },
            "Output": "{% $states.input %}",
            "Next": "Decide"
          },
          "Decide": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $count($calls) > 0 and $round < 6 %}",
                "Next": "RunTools"
              },
              {
                "Condition": "{% $count($calls) > 0 %}",
                "Next": "GiveUp"
              },
              {
                "Condition": "{% $length($trim($reply)) = 0 %}",
                "Next": "GiveUp"
              }
            ],
            "Default": "Answered"
          },
          "RunTools": {
            "Type": "Map",
            "Items": "{% $calls %}",
            "MaxConcurrency": 3,
            "ItemProcessor": {
              "ProcessorConfig": {
                "Mode": "INLINE"
              },
              "StartAt": "Args",
              "States": {
                "Args": {
                  "Type": "Pass",
                  "Assign": {
                    "callId": "{% $states.input.call_id %}",
                    "tool": "{% $states.input.name %}",
                    "a": "{% $parse($states.input.arguments) %}"
                  },
                  "Output": "{% $states.input %}",
                  "Next": "Gate"
                },
                "Gate": {
                  "Type": "Choice",
                  "Choices": [
                    {
                      "Condition": "{% $tool = 'search_contacts' and 'search_contacts' in $allowedTools %}",
                      "Next": "Run_search_contacts"
                    },
                    {
                      "Condition": "{% $tool = 'add_note' and 'add_note' in $allowedTools %}",
                      "Next": "Run_add_note"
                    }
                  ],
                  "Default": "Denied"
                },
                "Denied": {
                  "Type": "Pass",
                  "Output": "{% { 'call_id': $callId, 'output': 'This tool is not available for this business.' } %}",
                  "End": true
                },
                "Run_search_contacts": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::http:invoke",
                  "Arguments": {
                    "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_SEARCH_CONTACTS_BY_CRITERIA",
                    "Method": "POST",
                    "Authentication": {
                      "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
                    },
                    "RequestBody": {
                      "user_id": "{% $tenant.tenantId.S %}",
                      "arguments": {
                        "query": "{% $a.query %}",
                        "limit": 5,
                        "properties": [
                          "firstname",
                          "lastname",
                          "phone",
                          "mobilephone",
                          "email",
                          "company"
                        ]
                      }
                    }
                  },
                  "Retry": [
                    {
                      "ErrorEquals": [
                        "States.TaskFailed"
                      ],
                      "IntervalSeconds": 2,
                      "MaxAttempts": 1
                    }
                  ],
                  "Catch": [
                    {
                      "ErrorEquals": [
                        "States.ALL"
                      ],
                      "Next": "Failed"
                    }
                  ],
                  "Output": "{% ( $r := $states.result.ResponseBody; $s := $string($r.successful = true ? $r.{ 'total': data.total, 'contacts': [data.results.{ 'id': id, 'name': $trim(($exists(properties.firstname) and properties.firstname != null ? properties.firstname : '') & ' ' & ($exists(properties.lastname) and properties.lastname != null ? properties.lastname : '')), 'phone': properties.phone, 'mobile': properties.mobilephone, 'email': properties.email, 'company': properties.company }] } : { 'error': ($exists($r.error) and $r.error != null ? $r.error : 'tool failed') }); { 'call_id': $callId, 'output': ($length($s) > 6000 ? $substring($s, 0, 6000) & '...[truncated]' : $s) } ) %}",
                  "End": true
                },
                "Run_add_note": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::http:invoke",
                  "Arguments": {
                    "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_CREATE_NOTE",
                    "Method": "POST",
                    "Authentication": {
                      "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
                    },
                    "RequestBody": {
                      "user_id": "{% $tenant.tenantId.S %}",
                      "arguments": {
                        "hs_timestamp": "{% $now() %}",
                        "hs_note_body": "{% $replace($replace($replace($a.note, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') & '<br><br>Added by My Assistant' %}",
                        "associations": [
                          {
                            "to": {
                              "id": "{% $a.contact_id %}"
                            },
                            "types": [
                              {
                                "associationCategory": "HUBSPOT_DEFINED",
                                "associationTypeId": 202
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  "Retry": [
                    {
                      "ErrorEquals": [
                        "States.TaskFailed"
                      ],
                      "IntervalSeconds": 2,
                      "MaxAttempts": 1
                    }
                  ],
                  "Catch": [
                    {
                      "ErrorEquals": [
                        "States.ALL"
                      ],
                      "Next": "Failed"
                    }
                  ],
                  "Output": "{% ( $r := $states.result.ResponseBody; $s := $string($r.successful = true ? $r.{ 'ok': successful = true, 'note_id': data.id } : { 'error': ($exists($r.error) and $r.error != null ? $r.error : 'tool failed') }); { 'call_id': $callId, 'output': ($length($s) > 6000 ? $substring($s, 0, 6000) & '...[truncated]' : $s) } ) %}",
                  "End": true
                },
                "Failed": {
                  "Type": "Pass",
                  "Output": "{% { 'call_id': $callId, 'output': 'The tool failed. Tell the person you could not complete that part.' } %}",
                  "End": true
                }
              }
            },
            "Assign": {
              "outputs": "{% [[$states.result].{ 'type': 'function_call_output', 'call_id': call_id, 'output': output }] %}",
              "round": "{% $round + 1 %}"
            },
            "Output": "{% $states.input %}",
            "Next": "Continue"
          },
          "Continue": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Arguments": {
              "ApiEndpoint": "https://api.openai.com/v1/responses",
              "Method": "POST",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
              },
              "Headers": {
                "content-type": "application/json"
              },
              "RequestBody": {
                "model": "gpt-5.5",
                "store": true,
                "max_output_tokens": 1200,
                "instructions": "{% $systemPrompt & ($count($memories) > 0 ? ' Things you remember about this person and this business: ' & $join($memories, ' | ') : '') %}",
                "tools": "{% [$toolDefs[name in $allowedTools]] %}",
                "previous_response_id": "{% $responseId %}",
                "input": "{% $outputs %}"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.Http.StatusCode.429",
                  "States.Http.StatusCode.500",
                  "States.Http.StatusCode.502",
                  "States.Http.StatusCode.503",
                  "States.Http.StatusCode.504"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Assign": {
              "responseId": "{% $states.result.ResponseBody.id %}",
              "calls": "{% [$states.result.ResponseBody.output[type='function_call']] %}",
              "reply": "{% $count($states.result.ResponseBody.output[type='message']) > 0 ? $join($states.result.ResponseBody.output[type='message'].content[type='output_text'].text, ' ') : '' %}",
              "tokens": "{% $tokens + $states.result.ResponseBody.usage.total_tokens %}",
              "inputTokens": "{% $inputTokens + $states.result.ResponseBody.usage.input_tokens %}",
              "outputTokens": "{% $outputTokens + $states.result.ResponseBody.usage.output_tokens %}"
            },
            "Output": "{% $states.input %}",
            "Next": "Decide"
          },
          "GiveUp": {
            "Type": "Pass",
            "Assign": {
              "reply": "Sorry, I could not finish that. Try asking in a simpler way."
            },
            "Output": "{% $states.input %}",
            "Next": "Answered"
          },
          "Answered": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $exists($reply) and $length($trim($reply)) > 0 %}",
                "Next": "SaveTurn"
              }
            ],
            "Default": "Silent"
          },
          "SaveTurn": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:bedrockagentcore:createEvent",
            "Arguments": {
              "MemoryId": "placeholder",
              "ActorId": "{% $actorId %}",
              "SessionId": "{% $sessionId %}",
              "EventTimestamp": "{% $now() %}",
              "Payload": [
                {
                  "Conversational": {
                    "Role": "USER",
                    "Content": {
                      "Text": "{% $text %}"
                    }
                  }
                },
                {
                  "Conversational": {
                    "Role": "ASSISTANT",
                    "Content": {
                      "Text": "{% $reply %}"
                    }
                  }
                }
              ]
            },
            "Output": "{% $states.input %}",
            "Next": "Healthy"
          },
          "Healthy": {
            "Type": "Succeed"
          },
          "Silent": {
            "Type": "Fail",
            "Error": "AssistantSilent",
            "Cause": "{% 'tenant ' & $states.input.tenantId.S & ': the assistant loop produced no text. Check this execution, then reproduce with scripts/test-assistant.mts against this tenant.' %}"
          }
        }
      },
      "End": true
    }
  }
}
