{
  "QueryLanguage": "JSONata",
  "StartAt": "IsIncomingCall",
  "States": {
    "IsIncomingCall": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.type = 'realtime.call.incoming' %}",
          "Next": "Parse"
        }
      ],
      "Default": "Ignored"
    },
    "Ignored": {
      "Type": "Succeed"
    },
    "Parse": {
      "Type": "Pass",
      "Assign": {
        "callId": "{% $states.input.data.call_id %}",
        "webhookId": "{% $states.input.id %}",
        "startedAt": "{% $now() %}",
        "to": "{% ( $h := $states.input.data.sip_headers; $val := function($n) { $h[$lowercase(name) = $lowercase($n)][0].value }; $e164 := function($v) { (   $m := $exists($v) ? $match($v, /(?:sips?|tel):\\+?([0-9][0-9().\\- ]*)/i) : [];   $raw := $count($m) > 0 ? $m[0].groups[0] : (($exists($v) and $contains($v, /^\\s*\\+?[0-9().\\- ]+\\s*$/)) ? $v : '');   $d := $replace($raw, /[^0-9]/, '');   ($length($d) >= 7 and $length($d) <= 15) ? '+' & $d : '' ) }; $c := [\"To\",\"Diversion\",\"X-Called-Number\",\"P-Called-Party-ID\",\"X-Twilio-To\"] ~> $map(function($n) { $e164($val($n)) }); $c := $c[$ != '']; $count($c) > 0 ? $c[0] : '' ) %}",
        "from": "{% ( $h := $states.input.data.sip_headers; $val := function($n) { $h[$lowercase(name) = $lowercase($n)][0].value }; $e164 := function($v) { (   $m := $exists($v) ? $match($v, /(?:sips?|tel):\\+?([0-9][0-9().\\- ]*)/i) : [];   $raw := $count($m) > 0 ? $m[0].groups[0] : (($exists($v) and $contains($v, /^\\s*\\+?[0-9().\\- ]+\\s*$/)) ? $v : '');   $d := $replace($raw, /[^0-9]/, '');   ($length($d) >= 7 and $length($d) <= 15) ? '+' & $d : '' ) }; $c := [\"From\",\"P-Asserted-Identity\",\"X-Twilio-From\"] ~> $map(function($n) { $e164($val($n)) }); $c := $c[$ != '']; $count($c) > 0 ? $c[0] : '' ) %}"
      },
      "Output": "{% $states.input %}",
      "Next": "HasCalledNumber"
    },
    "HasCalledNumber": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $to != '' %}",
          "Next": "LookupTenant"
        }
      ],
      "Default": "RejectUnknown"
    },
    "LookupTenant": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $to %}"
          }
        }
      },
      "Assign": {
        "tenant": "{% $states.result.Item %}"
      },
      "Output": "{% $states.input %}",
      "Next": "TenantState"
    },
    "TenantState": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $not($exists($tenant)) %}",
          "Next": "RejectUnknown"
        },
        {
          "Condition": "{% $tenant.active.BOOL = false %}",
          "Next": "RejectInactive"
        }
      ],
      "Default": "Claim"
    },
    "RejectUnknown": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% 'https://api.openai.com/v1/realtime/calls/' & $callId & '/reject' %}",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "status_code": 404
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "UnknownCalledNumber"
        }
      ],
      "Next": "UnknownCalledNumber"
    },
    "UnknownCalledNumber": {
      "Type": "Fail",
      "Error": "UnknownCalledNumber",
      "Cause": "No tenant row for the called number; rejected with SIP 404. Check the Twilio trunk numbers against the Tenants table."
    },
    "RejectInactive": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% 'https://api.openai.com/v1/realtime/calls/' & $callId & '/reject' %}",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "status_code": 603
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Next": "Rejected"
    },
    "Rejected": {
      "Type": "Succeed"
    },
    "Claim": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "placeholder",
        "Item": "{% $merge([{'callId': {'S': $callId}, 'tenantId': {'S': $tenant.tenantId.S}, 'tenantPhoneNumber': {'S': $tenant.phoneNumber.S}, 'to': {'S': $to}, 'webhookId': {'S': $webhookId}, 'status': {'S': 'claimed'}, 'startedAt': {'S': $startedAt}, 'expiresAt': {'N': $string($floor($millis() / 1000) + 90 * 86400)}}, ($from != '' ? {'from': {'S': $from}} : {})]) %}",
        "ConditionExpression": "attribute_not_exists(callId) OR #s = :failed",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "failed"
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "Next": "Duplicate"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "HasCrm"
    },
    "Duplicate": {
      "Type": "Succeed"
    },
    "HasCrm": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $from != '' and $tenant.crm.M.type.S = 'hubspot' and $tenant.crm.M.via.S = 'composio' %}",
          "Next": "HubspotAccount"
        }
      ],
      "Default": "HasCaller"
    },
    "HubspotAccount": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/connected_accounts",
        "Method": "GET",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "QueryParameters": {
          "user_ids": "{% $tenant.tenantId.S %}",
          "toolkit_slugs": "hubspot",
          "statuses": "ACTIVE"
        }
      },
      "TimeoutSeconds": 1,
      "Assign": {
        "accountId": "{% $states.result.ResponseBody.items[0].id %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "HasCaller"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "FindContact"
    },
    "FindContact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/proxy",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "endpoint": "/crm/v3/objects/contacts/search",
          "method": "POST",
          "connected_account_id": "{% $accountId %}",
          "body": {
            "filterGroups": [
              {
                "filters": [
                  {
                    "propertyName": "phone",
                    "operator": "EQ",
                    "value": "{% $from %}"
                  }
                ]
              },
              {
                "filters": [
                  {
                    "propertyName": "mobilephone",
                    "operator": "EQ",
                    "value": "{% $from %}"
                  }
                ]
              }
            ],
            "properties": [
              "firstname",
              "lastname",
              "phone"
            ],
            "limit": 1
          }
        }
      },
      "TimeoutSeconds": 2,
      "Assign": {
        "contact": "{% $states.result.ResponseBody.data.results[0] %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "HasCaller"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "HasContact"
    },
    "HasContact": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($contact.id) %}",
          "Next": "LastNote"
        }
      ],
      "Default": "HasCaller"
    },
    "LastNote": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/proxy",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "endpoint": "/crm/v3/objects/notes/search",
          "method": "POST",
          "connected_account_id": "{% $accountId %}",
          "body": {
            "filterGroups": [
              {
                "filters": [
                  {
                    "propertyName": "associations.contact",
                    "operator": "EQ",
                    "value": "{% $contact.id %}"
                  }
                ]
              }
            ],
            "sorts": [
              {
                "propertyName": "hs_timestamp",
                "direction": "DESCENDING"
              }
            ],
            "properties": [
              "hs_note_body",
              "hs_timestamp"
            ],
            "limit": 1
          }
        }
      },
      "TimeoutSeconds": 1,
      "Assign": {
        "note": "{% $states.result.ResponseBody.data.results[0].properties %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "HasCaller"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "HasCaller"
    },
    "HasCaller": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $from != '' %}",
          "Next": "RecallMemory"
        }
      ],
      "Default": "Accept"
    },
    "RecallMemory": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:bedrockagentcore:retrieveMemoryRecords",
      "TimeoutSeconds": 1,
      "Arguments": {
        "MemoryId": "placeholder",
        "NamespacePath": "{% '/callers/' & $tenant.tenantId.S & '_' & $replace($from, /[^0-9]/, '') %}",
        "SearchCriteria": {
          "SearchQuery": "who this caller is, their jobs, and their preferences",
          "TopK": 6
        }
      },
      "Assign": {
        "memories": "{% [$states.result.MemoryRecordSummaries.Content.Text] %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "Accept"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "Accept"
    },
    "Accept": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% 'https://api.openai.com/v1/realtime/calls/' & $callId & '/accept' %}",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "type": "realtime",
          "model": "{% $tenant.receptionist.M.session.M.model.S %}",
          "instructions": "{% 'You are ' & $tenant.receptionist.M.instructions.M.agentName.S & ', the phone receptionist for ' & $tenant.business.M.name.S & '. The call has just connected and the receptionist system will start the conversation in a moment. Until you receive new instructions, do not speak.' %}",
          "audio": {
            "output": {
              "voice": "{% $tenant.receptionist.M.session.M.audio.M.output.M.voice.S %}"
            }
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.404"
          ],
          "Output": "{% $states.input %}",
          "Next": "MarkGone"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "MarkFailed"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "MarkAccepted"
    },
    "MarkGone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $callId %}"
          }
        },
        "UpdateExpression": "SET #s = :s, #e = :e",
        "ExpressionAttributeNames": {
          "#s": "status",
          "#e": "error"
        },
        "ExpressionAttributeValues": {
          ":s": {
            "S": "failed"
          },
          ":e": {
            "S": "call gone before accept"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Gone"
    },
    "Gone": {
      "Type": "Succeed"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $callId %}"
          }
        },
        "UpdateExpression": "SET #s = :s, #e = :e",
        "ExpressionAttributeNames": {
          "#s": "status",
          "#e": "error"
        },
        "ExpressionAttributeValues": {
          ":s": {
            "S": "failed"
          },
          ":e": {
            "S": "accept failed"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "AcceptFailed"
    },
    "AcceptFailed": {
      "Type": "Fail",
      "Error": "AcceptFailed",
      "Cause": "OpenAI did not accept the call (gone, or an API error); the call row is marked failed"
    },
    "MarkAccepted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $callId %}"
          }
        },
        "UpdateExpression": "SET #s = :s",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":s": {
            "S": "accepted"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Enqueue"
    },
    "Enqueue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "placeholder",
        "MessageBody": "{% $string($merge([ {'callId': $callId, 'tenantPhoneNumber': $tenant.phoneNumber.S, 'startedAt': $startedAt, 'to': $to}, ($from != '' ? {'from': $from} : {}), {'extras': $merge([   ($from != '' ? {'callerPhone': $from} : {}),   ($exists($contact.id) ? {'knownCaller': $merge([{'contactId': $contact.id}, ($trim(($exists($contact.properties.firstname) and $contact.properties.firstname != null ? $contact.properties.firstname : '') & ' ' & ($exists($contact.properties.lastname) and $contact.properties.lastname != null ? $contact.properties.lastname : '')) != '' ? {'name': $trim(($exists($contact.properties.firstname) and $contact.properties.firstname != null ? $contact.properties.firstname : '') & ' ' & ($exists($contact.properties.lastname) and $contact.properties.lastname != null ? $contact.properties.lastname : ''))} : {}),     ($exists($note.hs_note_body) ? {'lastNote': $trim($replace($replace($replace($note.hs_note_body, /<br[^>]*>/, ' '), /<[^>]+>/, ' '), /\\s+/, ' ')), 'lastNoteAt': $note.hs_createdate} : {})])} : {}),   ($count($memories) > 0 ? {'callerMemory': $memories} : {}) ])}])) %}"
      },
      "End": true
    }
  }
}
