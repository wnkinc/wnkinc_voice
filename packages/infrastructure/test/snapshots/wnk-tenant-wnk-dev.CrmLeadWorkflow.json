{
  "QueryLanguage": "JSONata",
  "StartAt": "CheckDone",
  "States": {
    "CheckDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $states.input.detail.callId %}"
          }
        },
        "ProjectionExpression": "#k",
        "ExpressionAttributeNames": {
          "#k": "{% 'done:crm:lead:' & $states.input.detail.lead.leadId %}"
        }
      },
      "Assign": {
        "done": "{% $exists($states.result.Item) and $count($keys($states.result.Item)) > 0 %}"
      },
      "Output": "{% $states.input %}",
      "Next": "AlreadyDone"
    },
    "AlreadyDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $done %}",
          "Next": "Skipped"
        }
      ],
      "Default": "LookupTenant"
    },
    "Skipped": {
      "Type": "Succeed"
    },
    "LookupTenant": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $states.input.detail.tenantPhoneNumber %}"
          }
        }
      },
      "Assign": {
        "tenant": "{% $states.result.Item %}",
        "name": "{% $trim($states.input.detail.lead.callerName) %}",
        "first": "{% $split($trim($states.input.detail.lead.callerName), ' ')[0] %}",
        "last": "{% $trim($substringAfter($trim($states.input.detail.lead.callerName), ' ')) %}"
      },
      "Output": "{% $states.input %}",
      "Next": "HasCrm"
    },
    "HasCrm": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.detail.lead.phone) and $tenant.crm.M.type.S = 'hubspot' and $tenant.crm.M.via.S = 'composio' %}",
          "Next": "FindContact"
        }
      ],
      "Default": "Skipped"
    },
    "FindContact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_SEARCH_CONTACTS_BY_CRITERIA",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": {
            "filterGroups": [
              {
                "filters": [
                  {
                    "propertyName": "phone",
                    "operator": "EQ",
                    "value": "{% $states.input.detail.lead.phone %}"
                  }
                ]
              },
              {
                "filters": [
                  {
                    "propertyName": "mobilephone",
                    "operator": "EQ",
                    "value": "{% $states.input.detail.lead.phone %}"
                  }
                ]
              }
            ],
            "properties": [
              "firstname",
              "lastname",
              "phone"
            ],
            "limit": 1
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "contacts": "{% [$states.result.ResponseBody.data.results] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "HasContact"
    },
    "HasContact": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($contacts) > 0 %}",
          "Next": "MissingNames"
        }
      ],
      "Default": "CreateContact"
    },
    "CreateContact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_CREATE_CONTACT",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": "{% $merge([{'phone': $states.input.detail.lead.phone}, ($first != '' ? {'firstname': $first} : {}), ($last != '' ? {'lastname': $last} : {})]) %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "contactId": "{% $states.result.ResponseBody.data.id %}"
      },
      "Output": "{% $states.input %}",
      "Next": "AddNote"
    },
    "MissingNames": {
      "Type": "Pass",
      "Assign": {
        "contactId": "{% $contacts[0].id %}",
        "props": "{% $merge([($first != '' and ($exists($contacts[0].properties.firstname) and $contacts[0].properties.firstname != null ? $contacts[0].properties.firstname : '') = '' ? {'firstname': $first} : {}), ($last != '' and ($exists($contacts[0].properties.lastname) and $contacts[0].properties.lastname != null ? $contacts[0].properties.lastname : '') = '' ? {'lastname': $last} : {})]) %}"
      },
      "Output": "{% $states.input %}",
      "Next": "NeedsUpdate"
    },
    "NeedsUpdate": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($keys($props)) > 0 %}",
          "Next": "UpdateContact"
        }
      ],
      "Default": "AddNote"
    },
    "UpdateContact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_UPDATE_CONTACT",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": {
            "contactId": "{% $contactId %}",
            "properties": "{% $props %}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "AddNote"
    },
    "AddNote": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_CREATE_NOTE",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": {
            "hs_timestamp": "{% $now() %}",
            "hs_note_body": "{% 'Phone lead via receptionist (' & $tenant.business.M.name.S & ' line)<br><br>' & 'Reason: ' & $replace($replace($replace($states.input.detail.lead.reason, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') & '<br>' & ($exists($states.input.detail.lead.preferredCallbackTime) ? 'Preferred callback: ' & $replace($replace($replace($states.input.detail.lead.preferredCallbackTime, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') & '<br>' : '') & ($exists($states.input.detail.lead.notes) ? 'Notes: ' & $replace($replace($replace($states.input.detail.lead.notes, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') & '<br>' : '') & '<br>Call ID: ' & $states.input.detail.callId %}",
            "associations": [
              {
                "to": {
                  "id": "{% $contactId %}"
                },
                "types": [
                  {
                    "associationCategory": "HUBSPOT_DEFINED",
                    "associationTypeId": 202
                  }
                ]
              }
            ]
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "DefaultOwner"
    },
    "DefaultOwner": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_RETRIEVE_OWNERS",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": {
            "limit": 1
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "ownerId": "{% $states.result.ResponseBody.data.results[0].id %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "AddTask"
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "AddTask"
    },
    "AddTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_CREATE_TASK",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": "{% $merge([{ 'hs_timestamp': ( $zone := (180 - ($exists($tenant.sessionDayOffsetMinutes.N) ? $number($tenant.sessionDayOffsetMinutes.N) : 600)) * 60000; $nowMs := $millis(); $day := $floor(($nowMs + $zone) / 86400000); $due := [0..7] ~> $map(function($i) { ( $d := $day + $i; $dow := ($d + 4) % 7; ($dow != 0 and $dow != 6) ? ($d * 86400000 + 9 * 3600000 - $zone) : 0 ) }) ~> $filter(function($t) { $t > $nowMs }); $fromMillis($due[0]) ), 'hs_task_subject': 'Follow up with ' & $name & ' (' & $states.input.detail.lead.phone & ')', 'hs_task_body': $replace($replace($replace($states.input.detail.lead.reason, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') & ($exists($states.input.detail.lead.preferredCallbackTime) ? '<br>Preferred: ' & $replace($replace($replace($states.input.detail.lead.preferredCallbackTime, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') : ''), 'hs_task_status': 'NOT_STARTED', 'hs_task_priority': 'MEDIUM', 'hs_task_type': 'TODO', 'associations': [{'to': {'id': $contactId}, 'types': [{'associationCategory': 'HUBSPOT_DEFINED', 'associationTypeId': 204}]}] }, ($exists($ownerId) ? {'hubspot_owner_id': $ownerId} : {})]) %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "MarkDone"
    },
    "MarkDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $states.input.detail.callId %}"
          }
        },
        "UpdateExpression": "SET #k = :at, expiresAt = if_not_exists(expiresAt, :ttl)",
        "ExpressionAttributeNames": {
          "#k": "{% 'done:crm:lead:' & $states.input.detail.lead.leadId %}"
        },
        "ExpressionAttributeValues": {
          ":at": {
            "S": "{% $now() %}"
          },
          ":ttl": {
            "N": "{% $string($floor($millis() / 1000) + 90 * 86400) %}"
          }
        }
      },
      "End": true
    }
  }
}
