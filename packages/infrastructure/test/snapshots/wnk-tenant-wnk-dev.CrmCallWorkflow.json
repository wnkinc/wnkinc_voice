{
  "QueryLanguage": "JSONata",
  "StartAt": "HasCaller",
  "States": {
    "HasCaller": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.detail.callerPhone) and $states.input.detail.status = 'completed' %}",
          "Next": "CheckDone"
        }
      ],
      "Default": "Skipped"
    },
    "Skipped": {
      "Type": "Succeed"
    },
    "CheckDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $states.input.detail.callId %}"
          }
        },
        "ProjectionExpression": "#k, transcript",
        "ExpressionAttributeNames": {
          "#k": "done:crm:call"
        }
      },
      "Assign": {
        "done": "{% $exists($states.result.Item.`done:crm:call`) %}",
        "transcript": "{% [$states.result.Item.transcript.L] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "AlreadyDone"
    },
    "AlreadyDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $done or $count($transcript) = 0 %}",
          "Next": "Skipped"
        }
      ],
      "Default": "LookupTenant"
    },
    "LookupTenant": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "phoneNumber": {
            "S": "{% $states.input.detail.tenantPhoneNumber %}"
          }
        }
      },
      "Assign": {
        "tenant": "{% $states.result.Item %}"
      },
      "Output": "{% $states.input %}",
      "Next": "HasCrm"
    },
    "HasCrm": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.detail.callerPhone) and $tenant.crm.M.type.S = 'hubspot' and $tenant.crm.M.via.S = 'composio' %}",
          "Next": "FindContact"
        }
      ],
      "Default": "Skipped"
    },
    "FindContact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_SEARCH_CONTACTS_BY_CRITERIA",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": {
            "filterGroups": [
              {
                "filters": [
                  {
                    "propertyName": "phone",
                    "operator": "EQ",
                    "value": "{% $states.input.detail.callerPhone %}"
                  }
                ]
              },
              {
                "filters": [
                  {
                    "propertyName": "mobilephone",
                    "operator": "EQ",
                    "value": "{% $states.input.detail.callerPhone %}"
                  }
                ]
              }
            ],
            "properties": [
              "firstname",
              "lastname",
              "phone"
            ],
            "limit": 1
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Assign": {
        "contact": "{% $states.result.ResponseBody.data.results[0] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "HasContact"
    },
    "HasContact": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($contact.id) %}",
          "Next": "AddNote"
        }
      ],
      "Default": "Skipped"
    },
    "AddNote": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://backend.composio.dev/api/v3.1/tools/execute/HUBSPOT_CREATE_NOTE",
        "Method": "POST",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-west-2:123456789012:connection/placeholder/00000000-0000-0000-0000-000000000000"
        },
        "RequestBody": {
          "user_id": "{% $tenant.tenantId.S %}",
          "arguments": {
            "hs_timestamp": "{% $now() %}",
            "hs_note_body": "{% $substring('Call to ' & $tenant.business.M.name.S & ' line - ' & $string($round($states.input.detail.durationSeconds / 60)) & ' min, ' & $states.input.detail.status & '<br><br>' & $join($transcript[M.role.S != 'tool'].((M.role.S = 'user' ? 'Caller: ' : 'Agent: ') & $replace($replace($replace(M.text.S, '&', '&amp;'), '<', '&lt;'), '>', '&gt;')), '<br>') & '<br><br>Call ID: ' & $states.input.detail.callId, 0, 60000) %}",
            "associations": [
              {
                "to": {
                  "id": "{% $contact.id %}"
                },
                "types": [
                  {
                    "associationCategory": "HUBSPOT_DEFINED",
                    "associationTypeId": 202
                  }
                ]
              }
            ]
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 1
        }
      ],
      "Output": "{% $states.input %}",
      "Next": "MarkDone"
    },
    "MarkDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $states.input.detail.callId %}"
          }
        },
        "UpdateExpression": "SET #k = :at, expiresAt = if_not_exists(expiresAt, :ttl)",
        "ExpressionAttributeNames": {
          "#k": "done:crm:call"
        },
        "ExpressionAttributeValues": {
          ":at": {
            "S": "{% $now() %}"
          },
          ":ttl": {
            "N": "{% $string($floor($millis() / 1000) + 90 * 86400) %}"
          }
        }
      },
      "End": true
    }
  }
}
