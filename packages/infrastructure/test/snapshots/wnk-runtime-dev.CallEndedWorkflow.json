{
  "QueryLanguage": "JSONata",
  "StartAt": "Completed",
  "States": {
    "Completed": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.detail.status = 'completed' and $states.input.detail.durationSeconds > 0 %}",
          "Next": "CheckDone"
        }
      ],
      "Default": "Skipped"
    },
    "Skipped": {
      "Type": "Succeed"
    },
    "CheckDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $states.input.detail.callId %}"
          }
        },
        "ProjectionExpression": "#k, transcript",
        "ExpressionAttributeNames": {
          "#k": "done:call.ended"
        }
      },
      "Assign": {
        "done": "{% $exists($states.result.Item.`done:call.ended`) %}",
        "transcript": "{% [$states.result.Item.transcript.L] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "AlreadyDone"
    },
    "AlreadyDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $done %}",
          "Next": "Skipped"
        }
      ],
      "Default": "Usage"
    },
    "Usage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "placeholder",
        "Item": {
          "tenantId": {
            "S": "{% $states.input.detail.tenantId %}"
          },
          "sk": {
            "S": "{% $now() & '#voice_minutes#' & $uuid() %}"
          },
          "meter": {
            "S": "voice_minutes"
          },
          "units": {
            "N": "{% $string($states.input.detail.durationSeconds / 60) %}"
          },
          "ref": {
            "S": "{% $states.input.detail.callId %}"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "HasTranscript"
    },
    "HasTranscript": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.detail.callerPhone) and $count($transcript[M.role.S != 'tool']) > 0 %}",
          "Next": "RememberCall"
        }
      ],
      "Default": "MarkDone"
    },
    "RememberCall": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:bedrockagentcore:createEvent",
      "Arguments": {
        "MemoryId": "placeholder",
        "ActorId": "{% $states.input.detail.tenantId & '_' & $replace($states.input.detail.callerPhone, /[^0-9]/, '') %}",
        "SessionId": "{% $states.input.detail.callId %}",
        "EventTimestamp": "{% $now() %}",
        "Payload": "{% [$transcript[M.role.S != 'tool'].{'Conversational': {'Role': (M.role.S = 'user' ? 'USER' : 'ASSISTANT'), 'Content': {'Text': M.text.S}}}] %}"
      },
      "Output": "{% $states.input %}",
      "Next": "MarkDone"
    },
    "MarkDone": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "placeholder",
        "Key": {
          "callId": {
            "S": "{% $states.input.detail.callId %}"
          }
        },
        "UpdateExpression": "SET #k = :at, expiresAt = if_not_exists(expiresAt, :ttl)",
        "ExpressionAttributeNames": {
          "#k": "done:call.ended"
        },
        "ExpressionAttributeValues": {
          ":at": {
            "S": "{% $now() %}"
          },
          ":ttl": {
            "N": "{% $string($floor($millis() / 1000) + 90 * 86400) %}"
          }
        }
      },
      "End": true
    }
  }
}
